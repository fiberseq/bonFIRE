rule combine_peaks:
    input:
        input_tbl["peaks_file"].tolist()
    output:
        combined_peaks_bed = f"{global_output_dir}/{sample}/{sample}_combined_peaks.bed.gz"
    run:
        import gzip

        with gzip.open(combined_peaks_bed[0], "wt") as outfile:
            for peak_file, sample_name in PEAKS:
                with gzip.open(peak_file, "rt") as infile:
                    for line in infile:
                        fields = line.rstrip("\n").split("\t")
                        outfile.write(
                            "\t".join(fields[:3] + [sample_name]) + "\n"
                        )

rule make_bed_with_haps_and_peakIDs:
    input:
        input_bed=rules.combine_peaks.output.combined_peaks_bed
    output:
        output_bed=f"{global_output_dir}/{sample}/{sample}_wHapsAndPeakIDs.bed.gz",
        output_bed_unzipped=f"{global_output_dir}/{sample}/{sample}_wHapsAndPeakIDs.bed"
    conda:
        "envs/env.yml"
    shell:
        """
        (
            gzip -cd "{input.input_bed}" 2>/dev/null || cat "{input.input_bed}"
        ) | awk -F'\t' '
            BEGIN {{ OFS="\t" }}
            NR == 1 {{
                if ($2 ~ /^[0-9]+$/) {{
                    header = "#chrom\tstart\tend"
                    for (i = 4; i <= NF; i++) {{
                        header = header "\tcol" i
                    }}
                    print header, "peak_id"
                }} else {{
                    print $0, "peak_id"
                    next
                }}
            }}
            {{
                peak_id = $1"_"$2"_"$3
                print $0, peak_id
            }}' > {output.output_bed_unzipped}

            colname="peak_id"
            col_num=$(awk -F '\\t' -v colname="$colname" ' 
            NR==1 {{
                for (i=1; i <= NF; i++)
                    if ($i == colname) 
                        print i
            }}' "{output.output_bed_unzipped}")

            duplicates=$(tail -n +2 "{output.output_bed_unzipped}" \
            | cut -f"$col_num" \
            | sort \
            | uniq -c \
            | awk '$1 > 1 {{print $2}}')

            dup_array=($duplicates)

            if [[ -n "$duplicates" ]]; then
                echo "Duplicates found:"
                grep -v -F -f <(printf "%s\n" "${{dup_array[@]}}") {output.output_bed_unzipped} |  bgzip > {output.output_bed}
            else
                bgzip -c {output.output_bed_unzipped} > {output.output_bed}
            fi

        """

rule combine_fastas:
    input:
        ALL_FASTAS
    output:
        combined_fastas = temp(f"{global_output_dir}/{sample}/{sample}_combined_fastas.fa")
    shell:
        r"""
        for f in {input}; do
            if [[ "$f" == *.gz ]]; then
                zcat "$f"
            else
                cat "$f"
            fi
        done > {output.combined_fastas}
        """

rule make_graph:
    input:
        graph_input = graph_input_file
        #hap1_fasta_path = rules.make_fasta_files.output.hap1_fasta,
        #hap2_fasta_path = rules.make_fasta_files.output.hap2_fasta,
        #chm13_path=config.get("CHM13_fasta_path"),
        #hg38_path=config.get("GRCh38_fasta_path")
    output:
        #cp_graph_input=f"{graphs_dir}/{{sample}}/{{sample}}_graph_input.txt",
        cp_graph=f"{graphs_dir}/{sample}.gbz"
    conda:
        "envs/env.yml"
    #params:
    #    hap1_new_tag=get_hap1_new_tag,
    #    hap2_new_tag=get_hap2_new_tag
    threads: TEMP_THREADS
    resources:
        mem_mb=200000,
        runtime=60*24
    shell:
        """
        if [ -d "{graphs_dir}/js" ]; then
            rm -r {graphs_dir}/js
        fi
        #rm -r {graphs_dir}/js

        cat {input.graph_input} > {graphs_dir}/inputs.txt

        sample_list=$(cat {input.graph_input} | cut -f1) 

        cactus-pangenome \
        {graphs_dir}/js \
        {graphs_dir}/inputs.txt \
        --outDir {graphs_dir}/ \
        --outName {sample} \
        --reference $sample_list \
        --vcfReference $sample_list \
        --defaultCores 4 \
        --vcf full \
        --giraffe full \
        --gfa full \
        --gbz full \
        --filter 0 \
        --noSplit \
        --binariesMode singularity

        """

