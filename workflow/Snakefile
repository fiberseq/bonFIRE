    'graph_prefix': ['CHM13', 'GRCh38'],
    'fasta_path' : ['chm13_fasta', 'hg38_fasta']
}
ref_fasta = pd.DataFrame(ref_fasta)

combined_fasta_tbl_w_refs= pd.concat(
    [combined_fasta_tbl[["graph_prefix", "fasta_path"]], ref_fasta],
    ignore_index=True
)

combined_fasta_tbl_w_refs = pd.concat([
    combined_fasta_tbl_w_refs.iloc[[-2]],   # second-to-last row
    combined_fasta_tbl_w_refs.iloc[:-2],    # everything except the last two rows
    combined_fasta_tbl_w_refs.iloc[[-1]]    # last row
]).reset_index(drop=True)

