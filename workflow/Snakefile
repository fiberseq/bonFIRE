rule surjection_loop:
    input:
        graph=graph,
        #bed=rules.add_peak_annotations_in_R.output.orig_bed_annotated_noCHM13,
        gam=rules.make_gam_of_untransferred_peaks.output.gam,
        graph_prefixes_input=graph_prefixes_input,
        annotated_bed_noCHM13=rules.make_untransferred_peaks_list.output.orig_bed_annotated_not_surjected
    output:
        annotated_bed_noCHM13_to_modify=temp(f"{global_output_dir}/{sample}/{sample}_wHapsAndPeakIDs_w_surject_info_NOT_SURJECTED_ONTO_CHM13_to_mod.bed"),
        surjected=temp(f"{global_output_dir}/{sample}/{sample}_SurjLoop_TEMP_surjected.bam"),
        surj_processed=temp(f"{global_output_dir}/{sample}/{sample}_SurjLoop_TEMP_surjected_processed.bam"),
        bed_final=temp(f"{global_output_dir}/{sample}/{sample}_SurjLoop_TEMP_surjected_processed.bed"),
        temp_annotated_bed=temp(f"{global_output_dir}/{sample}/{sample}_wHapsAndPeakIDs_w_surject_info_NOT_SURJECTED_ONTO_CHM13_w_TempForAnnotationLoop.bed"),
        fully_annotated_bed=f"{global_output_dir}/{sample}/{sample}_wHapsAndPeakIDs_w_surject_info_NOT_SURJECTED_ONTO_CHM13_w_FullyAnnotated.bed"
    conda:
        "envs/env_and_R_env_combined.yml"
    threads: 16
    resources:
        mem_mb=300000,
        runtime=60*24
    shell:
        """
        next_asm_for_file=$(cat {input.annotated_bed_noCHM13} | cut -f6 | sort | uniq -c | sort -nr | head -1 | awk '{{print $2}}')
        echo $next_asm_for_file > {next_asm_file}

        next_asm=$(<{next_asm_file})
        echo "CHM13" > {assemblies_surjected_onto_file}

        cp {input.annotated_bed_noCHM13} {output.annotated_bed_noCHM13_to_modify}

        while [[ "$next_asm" != "NONE" ]]; do
            echo $next_asm
            asm_graph_name=$( awk -v k="$next_asm" '$1 == k {{ print $2; exit }}' {input.graph_prefixes_input} )
            last_asm=$(tail -n 1 {assemblies_surjected_onto_file})
            
            if [[ "$asm_graph_name" == "$last_asm" ]]; then
                break
            fi
            
            grep -q "$asm_graph_name" {assemblies_surjected_onto_file} && break

            echo $asm_graph_name >> {assemblies_surjected_onto_file}

            ### surject and process

            sh {WORKFLOW_DIR}/scripts/260127_surject_w_fibertigs.txt \
                {input.graph} \
                {PATH_TO_FT} \
                {input.graph_prefixes_input} \
                {input.gam} \
                {output.surjected} \
                {output.surj_processed} \
                {output.bed_final} \
                {WORKFLOW_DIR}/scripts \
                $asm_graph_name

            ### run R script to add info 
            Rscript {WORKFLOW_DIR}/scripts/260126_annotate_subsequent_peak_files_w_surjection_info.R \
                {output.annotated_bed_noCHM13_to_modify} \
                {output.bed_final} \
                $next_asm \
                {output.temp_annotated_bed} \
                {next_asm_file} \
                {length_change_param}

            mv {output.temp_annotated_bed} {output.annotated_bed_noCHM13_to_modify}     

            next_asm=$(<"{next_asm_file}")
        done

        cp {output.annotated_bed_noCHM13_to_modify} {output.temp_annotated_bed}
        cp {output.annotated_bed_noCHM13_to_modify} {output.fully_annotated_bed}

        """

rule call_global_peaks_on_chm13:
    input:
        bed=rules.make_untransferred_peaks_list.output.orig_bed_annotated_surjected
    output:
        bed_4col=f"{global_output_dir}/{sample}/{sample}_wHapsAndPeakIDs_w_surject_info_SURJECTED_ONTO_CHM13_4col.bed",
        mock_bam=temp(f"{global_output_dir}/{sample}/{sample}_wHapsAndPeakIDs_w_surject_info_SURJECTED_ONTO_CHM13_4col_mockbam.bam"),
        chm13_peaks=f"{global_output_dir}/{sample}/{sample}_CHM13_shared_peaks.bed",
        chm13_peaks_5col=temp(f"{global_output_dir}/{sample}/{sample}_CHM13_shared_peaks_5col.bed"),
        chm13_peaks_5col_w_peak_id=f"{global_output_dir}/{sample}/{sample}_CHM13_shared_peaks_6col.bed",
        chm13_peaks_5col_w_peak_id_zipped=f"{global_output_dir}/{sample}/{sample}_CHM13_shared_peaks_6col.bed.gz"
    conda:
        "envs/env.yml"
    resources:
        mem_mb=150000,
        runtime=60*24
    shell:
        """
        rm -f {global_output_dir}/{sample}/{sample}*SURJECTED_ONTO_CHM13_4col_mockbam.bam.tmp*
        awk 'NR==1 {{print "#chrom\tstart\tend\tsample"; next}} {{print $(NF-2), $(NF-1), $NF, $4"_"$(NF-2)}}' OFS="\t" {input.bed} > {output.bed_4col}
        {PATH_TO_FT} mock-fire {output.bed_4col} | samtools sort -o {output.mock_bam} --write-index
        {PATH_TO_FT} call-peaks {output.mock_bam} --min-fire-coverage 1 --min-fire-frac 0.01 > {output.chm13_peaks}
        cat {output.chm13_peaks} | cut -f1,2,3 > {output.chm13_peaks_5col}

        bash {WORKFLOW_DIR}/scripts/add_peak_id_col_to_bed_file.sh \
            {output.chm13_peaks_5col} \
            {output.chm13_peaks_5col_w_peak_id} \
            {output.chm13_peaks_5col_w_peak_id_zipped}
        """

