WORKFLOW_DIR=workflow.basedir

global_output_dir=config.get("output_dir")
sample=config.get("prefix")
input_file = config.get("input_file")
PATH_TO_FT = config.get("ft_path", "ft")
GRAPH_ONLY=config.get("make_graph_only", False)
# shared_ref: every run was processed against the same haploid reference (main_reference_fasta), so no
# graph is needed: consensus peaks are called on that reference directly (workflow/rules/shared_ref.smk).
# Otherwise each run is on its own assembly and peaks move through a graph (workflow/rules/graph_mode.smk)
SHARED_REF = config.get("shared_ref", False)
MAIN_REF_FASTA = config.get("main_reference_fasta", config.get("CHM13_fasta_path"))
if not MAIN_REF_FASTA:
    sys.exit("Set main_reference_fasta in the config")
if SHARED_REF and GRAPH_ONLY:
    sys.exit("shared_ref and make_graph_only can't both be set: shared_ref runs don't use a graph")

# a failed job is retried (restart-times in the profile) with twice the memory each time
def mem_for(mem_mb):
    return lambda wildcards, attempt: mem_mb * 2 ** (attempt - 1)

# for rules that can run out of time: each retry gets this much more time
def runtime_for(minutes):
    return lambda wildcards, attempt: minutes * attempt

# each rule writes its output here; failed jobs' logs are printed at the end of the run
log_dir=f"{global_output_dir}/{sample}/logs"
Path(f"{global_output_dir}/{sample}").mkdir(parents=True, exist_ok=True)

input_tbl=pd.read_csv(input_file, sep=r"\s+", keep_default_na=False)
# shared_ref runs only need these two columns; other columns are ignored there
missing_cols = [c for c in ["sample_name", "path_to_fire_output_folder"] if c not in input_tbl.columns]
if missing_cols:
    sys.exit(f"The input file is missing these columns: {missing_cols}")

# ft uses "|" and ";" inside its fa tag, and the sample name goes into peak_id
bad_sample_names = [s for s in input_tbl["sample_name"] if any(c in s for c in "|;")]
if bad_sample_names:
    sys.exit(f"sample_name can't contain '|' or ';': {bad_sample_names}")

# the one file in each FIRE output folder matching pattern; stops with every folder that has none
def find_fire_files(pattern):
    found = [next(Path(x).glob(pattern), None) for x in input_tbl["path_to_fire_output_folder"]]
    missing = [f"{s}: {x}" for s, x, f in zip(input_tbl["sample_name"], input_tbl["path_to_fire_output_folder"], found) if f is None]
    if missing:
        sys.exit(f"No {pattern} file in these FIRE output folders:\n" + "\n".join(missing))
    return [str(f) for f in found]

if GRAPH_ONLY==False:
    input_tbl["peaks_file"] = find_fire_files("*peaks.bed.gz")
else:
    input_tbl["peaks_file"] = "NA"


PEAKS_FILES_AND_NAMES = list(
    zip(
        input_tbl["peaks_file"],
        input_tbl["sample_name"]
    )
)

if GRAPH_ONLY==False:
    input_tbl["pileup_path"] = find_fire_files("*pileup.bed.gz")
else:
    input_tbl["pileup_path"] = "NA"

# These are rule inputs and the Snakefile is re-read on every run and every cluster job,
# so only rewrite them when the contents change. Otherwise the new mtime makes every
# downstream output (including the graph) look out of date.
def write_tsv_if_changed(df, path):
    new_contents = df.to_csv(sep='\t', index=False, header=False)
    if os.path.exists(path):
        with open(path) as f:
            if f.read() == new_contents:
                return
    with open(path, "w") as f:
        f.write(new_contents)

## tools that read sequence from the main reference by position need it uncompressed and indexed (.fai). A
## gzipped one is decompressed, and a plain one without an index is linked, into the output folder and indexed
## there (so nothing is written next to the reference); an indexed plain one is used as is
if MAIN_REF_FASTA.endswith(".gz") or not os.path.exists(f"{MAIN_REF_FASTA}.fai"):
    MAIN_REF_FASTA_PLAIN = f"{global_output_dir}/{sample}/{sample}_Ref.fa"
else:
    MAIN_REF_FASTA_PLAIN = MAIN_REF_FASTA

# the final outputs; All_Targets is set by the mode's rules file (included at the end), so it's read
# through a function, which runs after everything is loaded
rule all:
    input:
        lambda wildcards: All_Targets

## rules used in both modes

rule combine_peaks:
    input:
        input_tbl["peaks_file"].tolist()
    output:
        combined_peaks_bed = temp(f"{global_output_dir}/{sample}/{sample}_combined_peaks.bed.gz")
    run:
        import gzip

        with gzip.open(output.combined_peaks_bed, "wt") as outfile:
            for peak_file, sample_name in PEAKS_FILES_AND_NAMES:
                with gzip.open(peak_file, "rt") as infile:
                    next(infile)
                    for line in infile:
                        fields = line.rstrip("\n").split("\t")
                        outfile.write(
                            "\t".join(fields[:3] + [sample_name]) + "\n"
                        )

# the main reference, uncompressed and indexed in the output folder (only used when it's gzipped or has no index)
rule prepare_main_ref_fasta:
    input:
        fasta=MAIN_REF_FASTA
    output:
        fasta=temp(f"{global_output_dir}/{sample}/{sample}_Ref.fa"),
        # indexed here so the index is temporary too (tools would otherwise leave one behind)
        fai=temp(f"{global_output_dir}/{sample}/{sample}_Ref.fa.fai")
    conda:
        "envs/env.yml"
    log:
        f"{log_dir}/prepare_main_ref_fasta.log"
    shell:
        """
        exec > {log} 2>&1
        case {input.fasta} in
            *.gz) zcat {input.fasta} > {output.fasta} ;;
            *) ln -sfn "$(readlink -f {input.fasta})" {output.fasta} ;;
        esac
        samtools faidx {output.fasta}
        """

## the rules for each mode
if SHARED_REF:
    include: "rules/shared_ref.smk"
else:
    include: "rules/graph_mode.smk"
