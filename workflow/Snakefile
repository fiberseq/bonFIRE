            {input.surjected_beds}
        """

rule call_global_peaks_on_chm13:
    input:
        bed=rules.make_untransferred_peaks_list.output.orig_bed_annotated_surjected
    output:
        bed_4col=temp(f"{global_output_dir}/{sample}/{sample}_wHapsAndPeakIDs_w_surject_info_SURJECTED_ONTO_CHM13_4col.bed"),
        mock_bam=temp(f"{global_output_dir}/{sample}/{sample}_wHapsAndPeakIDs_w_surject_info_SURJECTED_ONTO_CHM13_4col_mockbam.bam"),
        chm13_peaks=f"{global_output_dir}/{sample}/{sample}_CHM13_shared_peaks.bed",
        chm13_peaks_5col=temp(f"{global_output_dir}/{sample}/{sample}_CHM13_shared_peaks_5col.bed"),
        chm13_peaks_5col_w_peak_id=f"{global_output_dir}/{sample}/{sample}_CHM13_shared_peaks_6col.bed",
        chm13_peaks_5col_w_peak_id_zipped=temp(f"{global_output_dir}/{sample}/{sample}_CHM13_shared_peaks_6col.bed.gz")
    conda:
        "envs/env.yml"
    resources:
        mem_mb=150000,
        runtime=60*24
    log:
        f"{log_dir}/call_global_peaks_on_chm13.log"
    shell:
        """
        exec > {log} 2>&1
        rm -f {global_output_dir}/{sample}/{sample}*SURJECTED_ONTO_CHM13_4col_mockbam.bam.tmp*
        awk 'NR==1 {{print "#chrom\tstart\tend\tsample"; next}} {{print $(NF-2), $(NF-1), $NF, $4"_"$(NF-2)}}' OFS="\t" {input.bed} > {output.bed_4col}
        {PATH_TO_FT} mock-fire {output.bed_4col} | samtools sort -o {output.mock_bam} --write-index
        {PATH_TO_FT} call-peaks {output.mock_bam} --min-fire-coverage 1 --min-fire-frac 0.01 > {output.chm13_peaks}
        cat {output.chm13_peaks} | cut -f1,2,3 > {output.chm13_peaks_5col}

        bash {WORKFLOW_DIR}/scripts/add_peak_id_col_to_bed_file.sh \
            {output.chm13_peaks_5col} \
            {output.chm13_peaks_5col_w_peak_id} \
            {output.chm13_peaks_5col_w_peak_id_zipped}
        """

rule call_global_peaks_on_nonCHM13:
    input:
        bed=rules.assign_untransferred_peaks_to_asms.output.fully_annotated_bed
    output:
        bed_4col=temp(f"{global_output_dir}/{sample}/{sample}_wHapsAndPeakIDs_w_surject_info_NOT_SURJECTED_ONTO_CHM13_w_FullyAnnotated_4col.bed"),
        mock_bam=temp(f"{global_output_dir}/{sample}/{sample}_wHapsAndPeakIDs_w_surject_info_NOT_SURJECTED_ONTO_CHM13_w_FullyAnnotated_4col_mockbam.bam"),
        NONchm13_peaks=f"{global_output_dir}/{sample}/{sample}_NonCHM13_shared_peaks.bed",
        NONchm13_peaks_5col=temp(f"{global_output_dir}/{sample}/{sample}_NonCHM13_shared_peaks_5col.bed"),
        NONchm13_peaks_5col_w_peak_id=f"{global_output_dir}/{sample}/{sample}_NonCHM13_shared_peaks_6col.bed",
        NONchm13_peaks_5col_w_peak_id_zipped=temp(f"{global_output_dir}/{sample}/{sample}_NonCHM13_shared_peaks_6col.bed.gz")
    conda:
        "envs/env.yml"
    resources:
        mem_mb=150000,
        runtime=60*24
    log:
        f"{log_dir}/call_global_peaks_on_nonCHM13.log"
    shell:
        """
        exec > {log} 2>&1
        rm -f {global_output_dir}/{sample}/{sample}*NOT_SURJECTED_ONTO_CHM13_w_FullyAnnotated_4col_mockbam.bam.tmp*

        cat {input.bed} | awk '$7!="NONE"' | awk 'NR==1 {{print "#chrom\tstart\tend\tsample"; next}} {{print $(NF-2), $(NF-1), $NF, $4"_"$(NF-2)}}' OFS="\t" > {output.bed_4col}
        {PATH_TO_FT} mock-fire {output.bed_4col} | samtools sort -o {output.mock_bam} --write-index
        {PATH_TO_FT} call-peaks {output.mock_bam} --min-fire-coverage 1 --min-fire-frac 0.01 > {output.NONchm13_peaks}
        cat {output.NONchm13_peaks} | cut -f1,2,3 > {output.NONchm13_peaks_5col}

        bash {WORKFLOW_DIR}/scripts/add_peak_id_col_to_bed_file.sh \
            {output.NONchm13_peaks_5col} \
            {output.NONchm13_peaks_5col_w_peak_id} \
            {output.NONchm13_peaks_5col_w_peak_id_zipped}
        """

